# Elasticsearch Cloud -> your deployment -> Connect -> API key
ELASTICSEARCH_URL=https://your-deployment.es.region.provider.elastic.cloud
ELASTICSEARCH_API_KEY=your-elasticsearch-api-key

# OpenRouter -> Settings -> API Keys -> Create key
OPENROUTER_API_KEY=your-openrouter-api-key

# Vapi Dashboard -> Settings -> API Keys (use the private server key)
VAPI_API_KEY=your-vapi-private-key

# Vapi Dashboard -> Assistants -> open your existing agent -> copy its ID
VAPI_ASSISTANT_ID=your-vapi-assistant-id

# Vapi Dashboard -> Phone Numbers -> open your imported Twilio number -> copy the Vapi ID
# This is an ID such as a UUID, not the +1 phone number and not a Twilio SID.
VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id

# The only E.164 destination allowed for live demo calls. Use a number whose owner consented.
DEMO_RECIPIENT_PHONE=+15555550123

# Protects the live-call endpoint on a public deployment. Choose a private demo PIN.
DEMO_CALL_PIN=change-this-demo-pin

